    "test:desktop": "node --test electron/desktop.test.cjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.3.4",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "main": "electron/main.cjs"
}
